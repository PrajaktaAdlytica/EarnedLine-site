{
  "name": "earnedline-video",
  "version": "1.0.0",
  "description": "EarnedLine Evidence in Motion hero film \u2014 synthetic concept preview",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "tsc --noEmit",
    "render:hero": "remotion render EarnedLineHero ../public/media/earnedline-hero.mp4 --codec=h264 --crf=23 --concurrency=1 --image-format=png --x264-preset=fast --chrome-mode=chrome-for-testing",
    "poster:desktop": "remotion still EarnedLinePoster ../public/media/earnedline-hero-poster.png --chrome-mode=chrome-for-testing",
    "poster:mobile": "remotion still EarnedLineMobile ../public/media/earnedline-hero-mobile.png --chrome-mode=chrome-for-testing",
    "render:mobile": "remotion render EarnedLineMobileHero ../public/media/earnedline-hero-mobile.mp4 --codec=h264 --crf=23 --concurrency=1 --image-format=png --x264-preset=fast --chrome-mode=chrome-for-testing",
    "render:intro": "remotion render EarnedLineIntro ../../earnedline-intro-video/earnedline-intro.mp4 --codec=h264 --crf=17 --concurrency=2 --image-format=png --chrome-mode=chrome-for-testing",
    "render:intro-mobile": "remotion render EarnedLineIntroMobile ../../earnedline-intro-video/earnedline-intro-mobile.mp4 --codec=h264 --crf=18 --concurrency=1 --image-format=png --chrome-mode=chrome-for-testing"
  }
}
